{
  "name": "kubereats-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node scripts/create-gcs-404.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:e2e": "playwright test",
    "e2e:mock": "playwright test tests/e2e/mock-order-flow.spec.ts",
    "test:e2e:merchant-seed": "playwright test tests/e2e/merchant-onboarding-seed.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "seed:e2e-data": "node scripts/seed-e2e-data.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix"
  },
  "dependencies": {
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^24.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.7"
  }
}
